// FalloutNV resources (rebuilt). Binary inputs live in build/res (extracted at build time from the installed exe).
#define VS_VERSION_INFO 1
SPAFILE RT_RCDATA "build/res/spafile.bin"
180 BITMAP "build/res/bitmap180.bmp"
101 ICON "build/res/FalloutNV.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,0,525
 PRODUCTVERSION 1,4,0,525
 FILEFLAGSMASK 0x17L
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Bethesda Softworks"
            VALUE "FileDescription", "FalloutNV"
            VALUE "FileVersion", "1.4.0.525"
            VALUE "InternalName", "FalloutNV"
            VALUE "LegalCopyright", "Copyright  2010 ZeniMax Media Incorporated. All Rights Reserved."
            VALUE "OriginalFilename", "FalloutNV.exe"
            VALUE "ProductName", "Fallout: New Vegas"
            VALUE "ProductVersion", "1.4.0.525"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
1 24 "res-src/manifest.xml"
